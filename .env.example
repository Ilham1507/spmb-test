APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Lokasi binary MySQL untuk backup/pemulihan pada server hosting (opsional).
# DATABASE_DUMP_BINARY=/usr/bin/mysqldump
# DATABASE_CLIENT_BINARY=/usr/bin/mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PANITIA_WHATSAPP_NUMBER=082293094817
# Kosongkan untuk memakai nomor panitia di atas. Isi jika notifikasi pembayaran harus masuk ke WA admin khusus.
PAYMENT_NOTIFICATION_WHATSAPP_NUMBER=

# WhatsApp: Meta Cloud API resmi; tidak otomatis kembali ke Waslah.
# Jangan isi kredensial ini di Git; simpan sebagai Variables pada Railway.
WHATSAPP_PROVIDER=meta
WASLAH_API_TOKEN=
WASLAH_INSTANCE_KEY=

# Configure keys locally on the server. Never expose them to JavaScript or chat.
MIDTRANS_ENABLED=false
MIDTRANS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID=
# WhatsApp Business Cloud API (Meta)
# Nomor pengirim yang sudah terdaftar: +62 812-4707-5160.
# Isi Phone Number ID dan token permanen dari Meta Business Manager di server hosting.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SENDER_NUMBER=6281247075160
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Template Meta berstatus Approved untuk pesan yang dimulai pihak sekolah.
WHATSAPP_TEMPLATE_ACTIVATION=
WHATSAPP_TEMPLATE_NOTIFICATION=
WHATSAPP_TEMPLATE_INVOICE=
WHATSAPP_TEMPLATE_PASSWORD_RESET=
WHATSAPP_TEMPLATE_LANGUAGE=id
# Isi hanya sesudah template terkait berstatus APPROVED di Meta.
WHATSAPP_TEMPLATE_AUTHENTICATION=
WHATSAPP_TEMPLATE_INVOICE_FORMULIR=
WHATSAPP_TEMPLATE_INVOICE_DU=
WHATSAPP_TEMPLATE_INVOICE_RECEIVED=
WHATSAPP_TEMPLATE_TRANSFER_PENDING=
WHATSAPP_TEMPLATE_FORM_SUBMITTED=
WHATSAPP_TEMPLATE_SCHEDULE_CHANGED=
WHATSAPP_TEMPLATE_STAFF_RECEIPT=
WHATSAPP_TEMPLATE_TREASURER_PENDING=
