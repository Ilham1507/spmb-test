user nginx;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # Omit query strings: they can contain personal data and verification tokens.
    log_format app '$request_method $uri $status $request_time';
    access_log /dev/stdout app;
    sendfile on;
    server_tokens off;
    keepalive_timeout 30;

    server {
        listen __PORT__;
        listen [::]:__PORT__;
        server_name _;
        root /var/www/html/public;
        index index.php;
        charset utf-8;
        client_max_body_size 16m;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        # Only Laravel's front controller may execute PHP, never uploaded files.
        location = /index.php {
            include /etc/nginx/fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
            fastcgi_param DOCUMENT_ROOT $realpath_root;
            fastcgi_hide_header X-Powered-By;
            fastcgi_read_timeout 120s;
        }

        location ~* \.php(?:/|$) {
            return 404;
        }

        location ~ /\.(?!well-known) {
            deny all;
        }
    }
}
